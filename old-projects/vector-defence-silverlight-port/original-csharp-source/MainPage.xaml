<UserControl x:Class="VectorDefenceSL.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Height="520" Width="700">

    <UserControl.Resources>
        <!-- hides tower buidling buttons -->
        <Storyboard x:Name="hideTowerTypeButtonsStoryBoard">
            <DoubleAnimation Storyboard.TargetName="towerTypes"   Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:.15" />
            <DoubleAnimation Storyboard.TargetName="towerActions" Storyboard.TargetProperty="Opacity" BeginTime="0:0:.15" From="0" To="1" Duration="0:0:.15" />
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="towerTypes" Storyboard.TargetProperty="Visibility" Duration="0:0:.15">
                <ObjectAnimationUsingKeyFrames.KeyFrames>
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value><Visibility>Visible</Visibility></DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="0:0:.15">
                        <DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames.KeyFrames>
            </ObjectAnimationUsingKeyFrames>
            <!-- make tower actions visibile immediatly -->
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="towerActions" Storyboard.TargetProperty="Visibility">
                <ObjectAnimationUsingKeyFrames.KeyFrames>
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value><Visibility>Visible</Visibility></DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames.KeyFrames>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

        <!-- shows tower bulding buttons -->
        <Storyboard x:Name="showTowerTypeButtonsStoryBoard">
            <DoubleAnimation Storyboard.TargetName="towerActions" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:.15" />
            <DoubleAnimation  Storyboard.TargetName="towerTypes"  Storyboard.TargetProperty="Opacity" BeginTime="0:0:.15" From="0" To="1" Duration="0:0:.15" />
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="towerActions" Storyboard.TargetProperty="Visibility" Duration="0:0:.15">
                <ObjectAnimationUsingKeyFrames.KeyFrames>
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value><Visibility>Visible</Visibility></DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="0:0:.15">
                        <DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames.KeyFrames>
            </ObjectAnimationUsingKeyFrames>
            <!-- make tower types visibile immediatly -->
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="towerTypes" Storyboard.TargetProperty="Visibility">
                <ObjectAnimationUsingKeyFrames.KeyFrames>
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value><Visibility>Visible</Visibility></DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames.KeyFrames>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

        <!-- fades out the level name -->
        <Storyboard x:Name="levelNameStoryboard" Completed="LevelNameAnimationCompleted">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="levelNameTextBlock" Storyboard.TargetProperty="Opacity" >
                <DiscreteDoubleKeyFrame Value="1" KeyTime="0:0:0" />
                <DiscreteDoubleKeyFrame Value="1" KeyTime="0:0:0.5" />
                <LinearDoubleKeyFrame  Value="0" KeyTime="0:0:1.5" />
            </DoubleAnimationUsingKeyFrames>
            
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="levelNameTextBlock" Storyboard.TargetProperty="(Canvas.Top)">
                <DiscreteDoubleKeyFrame Value="164" KeyTime="0:0:0" />
                <DiscreteDoubleKeyFrame Value="164" KeyTime="0:0:0.5" />
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.5" />
            </DoubleAnimationUsingKeyFrames>            
        </Storyboard>

        <!-- fades in tower range indicator -->
        <Storyboard x:Name="showTowerRangeStoryboard">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="towerRangeIndicator" Storyboard.TargetProperty="Visibility">
                <ObjectAnimationUsingKeyFrames.KeyFrames>
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value><Visibility>Visible</Visibility></DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames.KeyFrames>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="towerRangeIndicator" Storyboard.TargetProperty="Opacity" From="0" To=".1" Duration="0:0:.25" />
        </Storyboard>

        <!-- fades out tower range indicator -->
        <Storyboard x:Name="hideTowerRangeStoryboard">
            <DoubleAnimation Storyboard.TargetName="towerRangeIndicator" Storyboard.TargetProperty="Opacity" From=".1" To="0" Duration="0:0:.25" />
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="towerRangeIndicator" Storyboard.TargetProperty="Visibility">
                <ObjectAnimationUsingKeyFrames.KeyFrames>
                    <DiscreteObjectKeyFrame KeyTime="0:0:.25">
                        <DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames.KeyFrames>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

    </UserControl.Resources>

    <Canvas Height="520" Name="rootCanvas" Width="700">
        <Canvas.Background>
            <LinearGradientBrush StartPoint="0,450" EndPoint="0,520" SpreadMethod="Pad" MappingMode="Absolute">
                <GradientStop Color="Black" Offset="0" />
                <GradientStop Color="DarkSlateGray" Offset=".7" />
            </LinearGradientBrush>
        </Canvas.Background>


        <Canvas Name="canvas" Background="Black" Width="700" Height="450" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" Canvas.Top="0" Canvas.Left="0" MouseMove="Canvas_MouseMove" MouseLeave="Canvas_MouseLeave">
            <Canvas.Clip>
                <RectangleGeometry Rect="0, 0, 700, 450"/>
            </Canvas.Clip>
            
            <Line Name="horizontalTargetLine" StrokeThickness="1" Stroke="White" Opacity=".3" Y1="0" Y2="1000" Canvas.ZIndex="100" Visibility="Collapsed" />
            <Line Name="verticalTargetLine" StrokeThickness="1" Stroke="White" Opacity=".3" X1="0" X2="1000" Canvas.ZIndex="100" Visibility="Collapsed" />

            <Ellipse Canvas.Top="40" Canvas.Left="300" Name="futureTower" StrokeThickness="1.5" Fill="Black" Stroke="White" Height="20" Width="20" Visibility="Collapsed" Opacity=".5" />
            <Ellipse Name="futureTowerRangeIndicator" StrokeThickness="1.5" Stroke="Green" Visibility="Collapsed" Opacity=".4" Canvas.Top="12" Canvas.Left="404" Height="100" Width="100" />
            <Ellipse Name="towerRangeIndicator" StrokeThickness="1.5" Stroke="Green" Visibility="Collapsed" Canvas.ZIndex="0"  Canvas.Left="535" Height="120" Width="120" Canvas.Top="12" Opacity="0.1">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Gray" Offset="1" />
                    </RadialGradientBrush> 
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Top="40" Canvas.Left="100" Name="towerSelectionIndicator" Height="30" Width="30" StrokeThickness="1.5" Stroke="White" Opacity=".5" StrokeDashArray="3, 2" Canvas.ZIndex="100" Visibility="Collapsed">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="towerSelectionIndicatorTransform" CenterX="15" CenterY="15" />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="towerSelectionIndicatorTransform" 
                                    Storyboard.TargetProperty="Angle" From="0" To="360" RepeatBehavior="Forever" Duration="0:0:10"  />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <Polyline Name="polyline" StrokeThickness="18" Stroke="#0C2C29" StrokeLineJoin="Round" />
            <Ellipse Canvas.Top="40" Canvas.Left="200" Name="finalPoint" Width="30" Height="30" Fill="#0C2C29" Visibility="Collapsed" />
            <TextBlock Canvas.Left="0" Canvas.Top="164" Name="levelNameTextBlock" Text="level name" Foreground="SpringGreen"
                       TextAlignment="Center" FontSize="90" FontWeight="Normal" Width="700" Visibility="Collapsed">
                <TextBlock.Effect><BlurEffect Radius="6" /></TextBlock.Effect>
            </TextBlock>
            <TextBlock Canvas.Left="200" Canvas.Top="44" Foreground="White" Name="leftToEscapeTextBlock" Text="0" TextAlignment="Center" Width="30" Visibility="Collapsed" />

        </Canvas>

        <StackPanel Name="towerActions" Visibility="Collapsed" Orientation="Horizontal" Canvas.Left="319" Canvas.Top="465" Width="267">
            <Button Name="sellTowerButton" Style="{StaticResource FlatButton}" Click="SellTowerButton_Click" Content="sell" Width="100" />
            <Button Name="upgradeTowerButton" Style="{StaticResource FlatButton}" Click="UpgradeButton_Click" Content="upgrade" Width="157" Margin="0" />
        </StackPanel>
        
        <StackPanel Name="towerTypes" Visibility="Collapsed" Orientation="Horizontal" Canvas.Left="88" Canvas.Top="465" Width="214">
            <Button Name="gunTowerButton" Style="{StaticResource FlatButton}" Click="TowerTypeButton_Click">
                <ToolTipService.ToolTip>Gun Tower</ToolTipService.ToolTip>
            </Button>
            <Button Name="laserTowerButton" Style="{StaticResource FlatButton}" Click="TowerTypeButton_Click">
                <ToolTipService.ToolTip>Laser Tower</ToolTipService.ToolTip>
            </Button>
            <Button Name="missleTowerButton" Style="{StaticResource FlatButton}" Click="TowerTypeButton_Click">
                <ToolTipService.ToolTip>Missle Tower</ToolTipService.ToolTip>
            </Button>
            <Button Name="slowTowerButton" Style="{StaticResource FlatButton}" Click="TowerTypeButton_Click" Margin="0">
                <ToolTipService.ToolTip>Slowing Tower</ToolTipService.ToolTip>
            </Button>
        </StackPanel>
        <Button Content="||" Name="pauseButton" Style="{StaticResource FlatButton}" Width="59" Click="PauseButton_Click" Canvas.Left="12" Canvas.Top="465" Visibility="Collapsed" Height="46" />
        <TextBlock Canvas.Left="592" Canvas.Top="470" Name="moneyTextBlock" Text="$0000" Foreground="Yellow" FontSize="25" Visibility="Collapsed" Width="96" TextAlignment="Right" />
    </Canvas>


</UserControl>
